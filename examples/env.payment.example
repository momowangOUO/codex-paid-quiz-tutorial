PAYMENT_SERVER_HOST=0.0.0.0
PAYMENT_SERVER_PORT=8787
PAYMENT_STORE_FILE=/data/payment-store.json
PUBLIC_BASE_URL=https://your-domain.example
CORS_ORIGIN=https://your-domain.example

PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=replace_with_paddle_api_key
PADDLE_CNY_PRICE_ID=pri_replace_with_cny_price_id
PADDLE_USD_PRICE_ID=pri_replace_with_usd_price_id
PADDLE_WEBHOOK_SECRET=replace_with_paddle_webhook_secret
PADDLE_DEFAULT_CHECKOUT_URL=https://your-domain.example/checkout
PADDLE_ALLOW_UNSIGNED_WEBHOOKS=false

